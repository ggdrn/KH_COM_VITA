+        seg = (max + 39) / 40 - 1;
+    } else {
+        w->gaugeMode = 1;
+        seg = (max - 280 + 39) / 40 - 1;
+    }
+    if (seg < 0) {
+        seg = 0;
+    }
+    if (seg > 6) {
+        seg = 6;
+    }
+    w->gaugeSize = seg;
+    if (w->gaugeMode == 0) {
