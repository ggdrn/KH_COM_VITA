+void PortFieldHudDraw(void) {
+    BtlHpplyWork* w = &sFieldHud;
+    s32 max = gGameState.progression.maxHp;
+    s32 hp = gGameState.hp;
+
+    if (!sFieldHudOn || max <= 0 || PortUiOverlayActive() || !PortFieldHudEnabled()) {
+        return;
+    }
+    if (hp > max) {
+        hp = max;
+    }
+    if (hp < 0) {
+        hp = 0;
+    }
+    w->displayHp = hp;
+    if (w->gaugeMode != 0) {
+        w->gaugeMode = hp > 280 ? 1 : 2;
+    }
+    switch (w->gaugeMode) {
+    case 0:
+        w->hpRatio = (hp << 8) / max;
+        break;
+    case 1:
+        w->hpRatio = ((hp - 280) << 8) / (max - 280);
+        break;
+    case 2:
+        w->hpRatio = (hp << 8) / 280;
+        break;
+    }
+    w->gfx = AnimUpdate(&w->anim);
+    w->gfx2 = AnimUpdate(&w->anim2);
+    if (gFieldState != 0 && (gFieldState->flags & 0x1000)) {
+        /* A menu is open over the field (pause, save): the HP display goes
+         * behind it, under every background layer and sprite in front. */
+        sHudAttr = 0xC10;
+        sHudOrderBias = 0xFF00;
+    }
+    task_btl_hpply_2(w);
+    sHudAttr = 0x410;
+    sHudOrderBias = 0;
+}
+
+void PortFieldHudClose(void) {
