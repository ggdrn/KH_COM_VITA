+
+/* Sprite pools are reset when the game changes mode: the HUD's tiles and
+ * palettes are still its own only if they still point at themselves and at
+ * the data it loaded. */
+static int FieldHudStillOwned(BtlHpplyWork* w) {
+    ObjTiles* const tiles[4] = { w->tiles, w->tiles2, w->tiles3, w->tiles4 };
+    ObjPalette* const pals[2] = { w->palette, w->palette2 };
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        if (tiles[i]->self != tiles[i] || tiles[i]->src != sFieldHudTileSrc[i]) {
+            return 0;
+        }
+    }
+    for (i = 0; i < 2; i++) {
+        if (pals[i]->self != pals[i] || pals[i]->src != sFieldHudPalSrc[i]) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+void PortFieldHudOpen(void) {
+    static void* const sSegmentFrames[7] = {
+        gBHpgagFrame19, gBHpgagFrame20, gBHpgagFrame21, gBHpgagFrame22,
+        gBHpgagFrame23, gBHpgagFrame24, gBHpgagFrame25,
+    };
+    BtlHpplyWork* w = &sFieldHud;
+    s32 max = gGameState.progression.maxHp;
+    s32 seg;
