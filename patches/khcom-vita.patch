diff --git a/include/gba/hwaddr.h b/include/gba/hwaddr.h
new file mode 100644
index 000000000..bf0658308
--- /dev/null
+++ b/include/gba/hwaddr.h
@@ -0,0 +1,25 @@
+#ifndef GUARD_GBA_HWADDR_H
+#define GUARD_GBA_HWADDR_H
+
+/*
+ * Addresses of GBA memory-mapped hardware. On the GBA these are the fixed bus
+ * addresses; on other platforms they point into emulated buffers owned by the
+ * platform layer. The integer type matches the original literals.
+ */
+#ifdef PLATFORM_VITA
+extern unsigned char gGbaPltt[0x400];
+extern unsigned char gGbaVram[0x18000];
+extern unsigned char gGbaOam[0x400];
+extern unsigned char gGbaSram[0x10000];
+#define HW_PLTT(off) ((int)gGbaPltt + (off))
+#define HW_VRAM(off) ((int)gGbaVram + (off))
+#define HW_OAM(off) ((int)gGbaOam + (off))
+#define HW_SRAM(off) ((int)gGbaSram + (off))
+#else
+#define HW_PLTT(off) (0x05000000 + (off))
+#define HW_VRAM(off) (0x06000000 + (off))
+#define HW_OAM(off) (0x07000000 + (off))
+#define HW_SRAM(off) (0x0E000000 + (off))
+#endif
+
+#endif /* GUARD_GBA_HWADDR_H */
