+    }
+    w->palette2 = LoadObjPalette(gBStatesPalette, 0x20);
+    w->tiles2 = AllocObjTiles(0x280, gBHpgagTiles);
+    w->tiles3 = AllocObjTiles(0x120, gBHpgagTiles);
+    w->tiles4 = AllocObjTiles(0x80, gBHpgagTiles);
+    if (w->palette == 0 || w->palette2 == 0 || w->tiles == 0 || w->tiles2 == 0 || w->tiles3 == 0 || w->tiles4 == 0) {
+        /* No room for it on this screen: stay hidden. */
+        FieldHudRelease(w);
+        return;
+    }
+    sFieldHudTileSrc[0] = ((ObjTiles*)w->tiles)->src;
+    sFieldHudTileSrc[1] = ((ObjTiles*)w->tiles2)->src;
+    sFieldHudTileSrc[2] = ((ObjTiles*)w->tiles3)->src;
+    sFieldHudTileSrc[3] = ((ObjTiles*)w->tiles4)->src;
+    sFieldHudPalSrc[0] = ((ObjPalette*)w->palette)->src;
+    sFieldHudPalSrc[1] = ((ObjPalette*)w->palette2)->src;
+    w->gfx2 = gBHpgagFrame1;
+    AnimInit(&w->anim2, gBHpgagAnims, gBHpgagFrames);
+    AnimStart(&w->anim, 0, 1);
