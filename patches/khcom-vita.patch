diff --git a/include/wide_layout.h b/include/wide_layout.h
new file mode 100644
index 000000000..d9422be1f
--- /dev/null
+++ b/include/wide_layout.h
@@ -0,0 +1,45 @@
+#ifndef GUARD_WIDE_LAYOUT_H
+#define GUARD_WIDE_LAYOUT_H
+
+#ifdef PLATFORM_VITA
+#include "port.h"
+/*
+ * Vita port, 16:9 layout of the menus drawn over the field (pause, save, the
+ * door's card selection): instead of being stretched, their parts are
+ * anchored to the edges of the wide screen at their own size. The left
+ * column (title, commands, cursor) moves into the left margin, the panels on
+ * the right into the right one, and the top and bottom bands are drawn twice,
+ * shifted both ways, so they span the screen.
+ */
+#define MENU_LEFT(x) ((x) - PortWideMargin())
+#define MENU_RIGHT(x) ((x) + PortWideMargin())
+#define MENU_LEFT_FX(x) ((x) - (PortWideMargin() << 8))
+/* The save menu's file panel is a 256-pixel BG map: moved by two whole tiles
+ * the wrapped-around columns that show on the left are its empty ones. */
+#define SAVE_SHIFT (PortWideMargin() > 0 ? 16 : 0)
+#define SAVE_RIGHT(x) ((x) + SAVE_SHIFT)
+/* A band drawn at column x, twice, shifted both ways. */
+#define MENU_BAND_X(x, y, gfx, tiles, pal, flags, order)                                   \
+    do {                                                                                  \
+        DrawSprite((x) - PortWideMargin(), y, gfx, tiles, pal, NULL, flags, order);       \
+        if (PortWideMargin() > 0) {                                                       \
+            DrawSprite((x) + PortWideMargin(), y, gfx, tiles, pal, NULL, flags, order);   \
+        }                                                                                 \
+    } while (0)
+#define MENU_BAND(y, gfx, tiles, pal, flags, order)                                        \
+    do {                                                                                  \
+        DrawSprite(128 - PortWideMargin(), y, gfx, tiles, pal, NULL, flags, order);       \
+        if (PortWideMargin() > 0) {                                                       \
+            DrawSprite(128 + PortWideMargin(), y, gfx, tiles, pal, NULL, flags, order);   \
+        }                                                                                 \
+    } while (0)
+#else
+#define MENU_LEFT(x) (x)
+#define MENU_RIGHT(x) (x)
+#define MENU_LEFT_FX(x) (x)
+#define SAVE_RIGHT(x) (x)
+#define MENU_BAND_X(x, y, gfx, tiles, pal, flags, order) DrawSprite(x, y, gfx, tiles, pal, NULL, flags, order)
+#define MENU_BAND(y, gfx, tiles, pal, flags, order) DrawSprite(128, y, gfx, tiles, pal, NULL, flags, order)
+#endif
+
+#endif
