+#ifdef PLATFORM_VITA
+/*
+ * Vita port: another save bank was loaded into SRAM (vita_main.c). Check and
+ * repair it the way the game does at boot (mode_copyright1.c), so a new,
+ * empty bank is formatted before the save and load screens read it.
+ */
+void PortCheckSaveBank(void) {
+    if (SaveRepairHeader() == 1) {
+        SaveClearHeader();
+        SaveClearSystem();
+        SaveClearFileLarge(0);
+        SaveClearFileLarge(1);
+        SaveClearFileSmall(0);
+        SaveClearFileSmall(1);
+    }
+    if (SaveRepairFileLarge(0) == 1) {
+        SaveClearFileLarge(0);
+    }
+    if (SaveRepairFileLarge(1) == 1) {
+        SaveClearFileLarge(1);
+    }
+    if (SaveRepairFileSmall(0) == 1) {
+        SaveClearFileSmall(0);
+    }
+    if (SaveRepairFileSmall(1) == 1) {
+        SaveClearFileSmall(1);
+    }
+    if (SaveRepairSystem() == 1) {
+        SaveClearSystem();
+    }
+}
+#endif
