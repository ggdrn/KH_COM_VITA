+static void FieldHudRelease(BtlHpplyWork* w) {
+    if (w->tiles != 0) {
+        ReleaseObjTiles(w->tiles);
+    }
+    if (w->tiles2 != 0) {
+        ReleaseObjTiles(w->tiles2);
+    }
+    if (w->tiles3 != 0) {
+        ReleaseObjTiles(w->tiles3);
+    }
+    if (w->tiles4 != 0) {
+        ReleaseObjTiles(w->tiles4);
+    }
+    if (w->palette2 != 0) {
