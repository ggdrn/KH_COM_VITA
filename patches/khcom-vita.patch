+        CreateREVCOUNTTask(&w->tasks, &w->listIndex, &w->cardsLeft[0], &w->revCountShown[0], 1);
+    }
+    TickSoraHcEffectOnReload();
+    m4aSongNumStart(SONG_SYS_CHAGEF2);
+}
+
+/* Where the stocked cards are on screen (their centres), for the port's
+ * unstock progress bar drawn under them (vita_notice.c). */
+void PortReportStock(CardBattleWork* w) {
+    s32 x0 = 0x7FFF, x1 = -0x8000, y = -0x8000;
+    u8 i, n = 0;
+
+    for (i = 0; i < w->stockCount && i < 3; i++) {
+        CardDisplayWork* c = w->stock[i];
+
+        if (c == NULL) {
+            continue;
+        }
+        if ((c->x >> 8) < x0) {
+            x0 = c->x >> 8;
+        }
+        if ((c->x >> 8) > x1) {
+            x1 = c->x >> 8;
+        }
+        if ((c->y >> 8) > y) {
+            y = c->y >> 8;
+        }
+        n++;
+    }
+    PortSetStockArea(n, x0, x1, y);
+}
