--- a/include/gba/io_reg.h
+++ b/include/gba/io_reg.h
@@ -3,7 +3,16 @@
 
 #include "types.h"
 
+#ifdef PLATFORM_VITA
+extern unsigned char gGbaIo[0x400];
+void GbaDmaReadback(volatile void* reg);
+#define REG_BASE ((int)gGbaIo)
+/* A DMA control write followed by this read starts the emulated transfer. */
+#define DMA_READBACK(dma, i) GbaDmaReadback(&(dma)[i])
+#else
 #define REG_BASE 0x04000000
+#define DMA_READBACK(dma, i) (dma)[i]
+#endif
 
 #define REG_OFFSET_DISPCNT     0x0
 #define REG_OFFSET_DISPSTAT    0x4
diff --git a/include/gba/romptr.h b/include/gba/romptr.h
new file mode 100644
index 000000000..a1f5d7551
--- /dev/null
+++ b/include/gba/romptr.h
@@ -0,0 +1,16 @@
+#ifndef GUARD_GBA_ROMPTR_H
+#define GUARD_GBA_ROMPTR_H
+
+/*
+ * Pointers stored inside binary ROM data (song streams, voicegroups, ...) are
+ * GBA bus addresses. GBA_PTR() is the identity on the GBA; on other platforms
+ * it maps such an address to where that data was loaded.
+ */
+#ifdef PLATFORM_VITA
+void* GbaPtr(const void* p);
+#define GBA_PTR(p) ((__typeof__(p))GbaPtr(p))
+#else
+#define GBA_PTR(p) (p)
+#endif
+
+#endif /* GUARD_GBA_ROMPTR_H */
