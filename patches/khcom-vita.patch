+        w->tiles = AllocObjTiles(0x280, gUnk_08B21438);
+        w->gfx = gUnk_08B213F0;
+        AnimInit(&w->anim, gUnk_09EE12C8, gUnk_09EE12BC);
+    } else {
+        w->palette = LoadObjPalette(gSoraPalette, 0x20);
+        w->tiles = AllocObjTiles(0x280, gUnk_08B20D6E);
